%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_graph
%%
%% An L2 hecate-om service: embeddable relational-graph database (CozoDB)
%% exposed as mesh procedures. Each instance runs its own CozoDB on local
%% disk (RocksDB). Consumers compose knowledge graphs from distinct sources
%% by calling resolve_link across instances and/or subscribing to the
%% entity_learned / link_learned fact streams.
%%
%% Mesh surface:
%%   mesh_call:  hecate_graph.resolve_link   — query links for an entity
%%   mesh_call:  hecate_graph.resolve_entity  — query entity attributes
%%   mesh_call:  hecate_graph.learn_link     — record a relationship
%%   mesh_publish: entity_learned            — implicit entity discovery
%%   mesh_publish: link_learned              — relationship discovered

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {hecate_om, "~> 0.23"}
]}.

%% Build the CozoDB NIF from native/hecate_graph_nif/ into priv/ before
%% rebar3 compiles Erlang. Idempotent — skips if already built. Tolerates
%% a missing Rust toolchain (Erlang wrapper returns {error, nif_not_loaded}).
{pre_hooks, [
    {compile, "sh -c 'B=\"${REBAR_DEPS_DIR}/hecate_graph\"; [ -f \"$B/priv/build-nifs.sh\" ] || B=\".\"; sh \"$B/priv/build-nifs.sh\" \"$B\"'"}
]}.

{project_plugins, [rebar3_ex_doc, rebar3_lint]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{relx, [
    {release, {hecate_graph, "0.1.0"}, [hecate_graph, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true},
    %% priv/build-nifs.sh's pre_hook writes the compiled NIF straight into
    %% apps/graph/priv/ (confirmed live in the build log), but the
    %% assembled release's lib/hecate_graph-0.1.0/ ships ebin/ only, no
    %% priv/ at all -- relx isn't picking the app's priv/ up on its own
    %% for this project (unlike a normal, present-from-the-start priv
    %% dir; this one is created mid-build by a pre_hook, and whatever
    %% relx's own priv-copy step keys off of evidently doesn't see it).
    %% An explicit overlay is unambiguous regardless of the actual cause:
    %% it runs as relx's own final release-assembly step, after
    %% everything else, copying a named file from wherever it is on disk
    %% straight into the release -- no dependence on app/priv discovery
    %% timing. hecate_graph_nif.erl resolves this same path at runtime
    %% via code:priv_dir(hecate_graph).
    {overlay, [
        {copy, "apps/graph/priv/hecate_graph_nif.so",
               "lib/hecate_graph-0.1.0/priv/hecate_graph_nif.so"}
    ]}
]}.

{profiles, [
    {test, [
        {deps, [{meck, "0.9.2"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

{dialyzer, [
    {warnings, [no_unknown]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        hecate_om
    ]}
]}.

{shell, [{apps, [hecate_graph]}]}.

{ex_doc, [
    {source_url, <<"https://github.com/hecate-services/hecate-graph">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE"]},
    {main, "README.md"}
]}.
