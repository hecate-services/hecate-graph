%% Substituted by relx at build; ${VAR} resolves from the environment at boot.
[
    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port,       ${HECATE_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        {realm,             <<"${HECATE_REALM}">>},

        %% MANDATORY BECAUSE THIS SERVICE ADVERTISES CAPABILITIES (see
        %% hecate_graph_service:capabilities/0). Without this,
        %% hecate_om_identity:keypair/0 returns {error, no_keypair}
        %% forever, and capability advertisement silently no-ops on
        %% every republish tick, permanently, with no crash and no
        %% error logged -- the service still connects, holds a valid
        %% realm, and answers /health, so it looks exactly like a
        %% healthy node while every one of its capabilities is
        %% unreachable. Found live 2026-09-01 on msi00: hecate-graph
        %% had been running healthy for 47+ minutes, fully invisible
        %% on the mesh. Same bug class hecate-mail/hecate-tube/
        %% hecate-rag already hit and fixed; see hecate-rag's own
        %% config/sys.config.src for the identical line this mirrors.
        %% Path is under the same persistent volume hecate_graph's own
        %% data_dir below uses, so the keypair self-heals once
        %% (generated + saved on first successful boot) and then
        %% survives every restart after.
        {identity_key_path, "/var/lib/hecate-graph/identity/keypair.erl.bin"}
    ]},

    {hecate_graph, [
        {data_dir, "/var/lib/hecate-graph"}
    ]},

    {kernel, [{logger_level, info}]}
].
